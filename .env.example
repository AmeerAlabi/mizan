# Copy to .env.local and fill in. Never commit real values.

# Zetaris (REST). API token: Management > API tokens. Org ID: Management > Organisation.
ZETARIS_REST_URL=https://your-cluster-host/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=

# Contact sent to SEC EDGAR, as "app_name email" (SEC requires a real contact).
SEC_USER_AGENT="mizan you@example.com"

# NVIDIA (build.nvidia.com), OpenAI-compatible.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# Meterless runtime (optional; OpenAI-compatible local gateway).
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
